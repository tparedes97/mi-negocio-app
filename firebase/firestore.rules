rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCompanion() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/companions/$(request.auth.uid));
    }

    function isFounder() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/companions/$(request.auth.uid)).data.role == 'founder';
    }

    // ---- Usuarios finales ----
    match /users/{userId} {
      allow read, update: if isOwner(userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false; // baja de cuenta se maneja vía Cloud Function, no borrado directo

      match /blockedSites/{siteId} {
        allow read, write: if isOwner(userId);
      }

      match /unlockAttempts/{attemptId} {
        allow read: if isOwner(userId) || isCompanion();
        allow create: if isOwner(userId);
        // El dueño actualiza su propio flujo (respuestas, decisión de
        // desbloquear, etc.) pero nunca puede tocar waitSeconds — eso lo
        // escribe únicamente el backend, para que no pueda ver ni
        // manipular su propio tiempo de espera (ver especificación).
        // Un compañero SÍ puede actualizar el intento: es lo que pasa
        // cuando "atiende" desde la cola y escribe chatId de vuelta.
        allow update: if isCompanion() || (
          isOwner(userId) &&
          !('waitSeconds' in request.resource.data.diff(resource.data).affectedKeys())
        );
      }
    }

    // ---- Chats ----
    match /chats/{chatId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isCompanion());
      allow create, update: if isCompanion(); // el estado del chat lo gobierna el backend/compañero
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          (get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid
            || isCompanion());
        allow create: if isSignedIn();
        allow update, delete: if false; // los mensajes son inmutables una vez enviados
      }
    }

    // ---- Compañeros (información privada, nunca visible al usuario final) ----
    match /companions/{companionUid} {
      allow read: if isFounder() || request.auth.uid == companionUid;
      allow write: if isFounder();
    }

    // ---- Turnos ----
    match /shiftAssignments/{docId} {
      allow read: if isCompanion();
      allow write: if isFounder();
    }
    match /shiftArchive/{docId} {
      allow read: if isCompanion();
      allow write: if false; // solo la Cloud Function de "lanzar calendario" escribe aquí
    }

    // ---- Donaciones y cancelaciones (analítica del negocio) ----
    match /donations/{docId} {
      allow read: if isFounder();
      allow write: if false; // las crea confirmCulqiCharge, nunca el cliente
    }
    match /cancellations/{docId} {
      allow read: if isFounder();
      allow write: if false; // reservado para cuando se implementen suscripciones recurrentes
    }

    // ---- Pagos pendientes (puente entre createCheckoutSession y confirmCulqiCharge) ----
    // Contiene el monto real a cobrar — nunca debe ser legible ni escribible
    // desde el cliente. Solo lo tocan las Cloud Functions vía Admin SDK,
    // que ignora estas reglas.
    match /pendingPayments/{docId} {
      allow read, write: if false;
    }

    // ---- Desbloqueos activos ----
    // El service worker de la extensión SOLO lee (para saber qué dominio
    // dejar de bloquear). Escribirlo directo desde el cliente permitiría
    // desbloquearse sin pagar — por eso allow write: if false, siempre.
    match /activeUnlocks/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}

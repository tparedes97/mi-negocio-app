{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20",
      "predeploy": [
        "mkdir -p $RESOURCE_DIR/shared && cp $RESOURCE_DIR/../../packages/shared/src/constants.js $RESOURCE_DIR/shared/constants.js"
      ]
    }
  ],
  "hosting": [
    {
      "target": "admin",
      "public": "../packages/admin/dist",
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    },
    {
      "target": "companion-portal",
      "public": "../packages/companion-portal/dist",
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    },
    {
      "target": "checkout",
      "public": "../packages/checkout"
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "functions": { "port": 5001 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true }
  }
}
